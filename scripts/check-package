#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import re
import stat
import subprocess
import sys
import tempfile
import zipfile
from email.parser import BytesParser
from pathlib import Path, PurePosixPath

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
WHEEL_NAME = re.compile(r"sangrep_contracts-0\.1\.0\.dev0-py3-none-any\.whl\Z")
REQUIRED_ENTRIES = {
    "sangrep_contracts/__init__.py",
    "sangrep_contracts/pack.py",
    "sangrep_contracts/pack_signing.py",
    "sangrep_contracts/schema_bounds.py",
    "sangrep_contracts/generated/pack_bounds_v1.py",
    "sangrep_contracts/generated/pack_manifest_v1.py",
    "sangrep_contracts/generated/pack_signature_v1.py",
    "sangrep_contracts/schemas/sangrep-pack-manifest-v1.json",
    "sangrep_contracts/schemas/sangrep-pack-signature-v1.json",
    "sangrep_contracts/vectors/v1/pack-manifest.json",
    "sangrep_contracts/vectors/v1/pack-signing.json",
    "sangrep_contracts/trust/development-pack-roots-v1.json",
}


class PackageCheckError(RuntimeError):
    pass


def _build_wheel(output: Path) -> Path:
    completed = subprocess.run(
        ["uv", "build", "--wheel", "--out-dir", str(output)],
        cwd=ROOT,
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        raise PackageCheckError("wheel build failed")
    wheels = tuple(output.glob("*.whl"))
    if len(wheels) != 1:
        raise PackageCheckError("wheel build did not produce exactly one artifact")
    return wheels[0]


def _metadata(archive: zipfile.ZipFile, names: set[str]) -> tuple[str, bytes]:
    metadata_names = [name for name in names if name.endswith(".dist-info/METADATA")]
    if len(metadata_names) != 1:
        raise PackageCheckError("wheel metadata entry is not unique")
    return metadata_names[0], archive.read(metadata_names[0])


def _verify_import(wheel: Path) -> None:
    probe = """
import importlib.resources
import sys
sys.path.insert(0, sys.argv[1])
import sangrep_contracts
assert sangrep_contracts.SangrepPackManifestV1.__name__ == "SangrepPackManifestV1"
root = importlib.resources.files("sangrep_contracts")
assert (root / "schemas/sangrep-pack-manifest-v1.json").read_bytes()
assert (root / "vectors/v1/pack-signing.json").read_bytes()
assert (root / "trust/development-pack-roots-v1.json").read_bytes()
"""
    completed = subprocess.run(
        [sys.executable, "-I", "-c", probe, str(wheel)],
        cwd=ROOT,
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        raise PackageCheckError("wheel import smoke failed")


def verify_wheel(wheel: Path) -> dict[str, object]:
    if not wheel.is_file() or wheel.is_symlink() or WHEEL_NAME.fullmatch(wheel.name) is None:
        raise PackageCheckError("wheel identity is invalid")
    payload = wheel.read_bytes()
    if len(payload) > 16 * 1024 * 1024:
        raise PackageCheckError("wheel exceeds the artifact budget")
    try:
        archive = zipfile.ZipFile(wheel)
    except zipfile.BadZipFile as error:
        raise PackageCheckError("wheel is not a valid ZIP archive") from error
    with archive:
        names: set[str] = set()
        for info in archive.infolist():
            path = PurePosixPath(info.filename)
            if path.is_absolute() or ".." in path.parts or info.filename in names:
                raise PackageCheckError("wheel contains an unsafe or duplicate path")
            mode = info.external_attr >> 16
            if stat.S_ISLNK(mode):
                raise PackageCheckError("wheel contains a symbolic link")
            names.add(info.filename)
        if not names >= REQUIRED_ENTRIES:
            raise PackageCheckError("wheel omits a required contract entry")
        license_entries = [name for name in names if name.endswith(".dist-info/licenses/LICENSE")]
        if len(license_entries) != 1:
            raise PackageCheckError("wheel license entry is not unique")
        _, metadata_bytes = _metadata(archive, names)
        message = BytesParser().parsebytes(metadata_bytes)
        if (
            message.get("Name") != "sangrep-contracts"
            or message.get("Version") != "0.1.0.dev0"
            or message.get("Requires-Python") != ">=3.11"
            or message.get("License-Expression") != "Apache-2.0"
            or message.get_all("License-File") != ["LICENSE"]
        ):
            raise PackageCheckError("wheel metadata contract is invalid")
        requirements = message.get_all("Requires-Dist") or []
        unconditional = [
            requirement for requirement in requirements if "extra == 'dev'" not in requirement
        ]
        if unconditional:
            raise PackageCheckError("wheel declares a runtime dependency")
        trust = json.loads(archive.read("sangrep_contracts/trust/development-pack-roots-v1.json"))
        roots = trust.get("roots")
        if (
            not isinstance(roots, list)
            or len(roots) != 1
            or roots[0].get("channels") != ["development"]
            or trust.get("revocations") != []
        ):
            raise PackageCheckError("wheel development trust registry is invalid")
    _verify_import(wheel)
    return {
        "schemaVersion": 1,
        "artifact": {
            "name": wheel.name,
            "sha256": hashlib.sha256(payload).hexdigest(),
            "bytes": len(payload),
        },
        "package": {
            "name": "sangrep-contracts",
            "version": "0.1.0.dev0",
            "requiresPython": ">=3.11",
            "licenseExpression": "Apache-2.0",
            "runtimeDependencies": [],
        },
        "includedContracts": {
            "schemas": 2,
            "vectors": 2,
            "developmentTrustRoots": 1,
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--wheel", type=Path)
    parser.add_argument("--report", type=Path)
    arguments = parser.parse_args()
    try:
        if arguments.wheel is None:
            with tempfile.TemporaryDirectory(prefix="sangrep-contracts-wheel-") as directory:
                report = verify_wheel(_build_wheel(Path(directory)))
        else:
            report = verify_wheel(arguments.wheel.resolve())
        if arguments.report is not None:
            arguments.report.write_text(
                json.dumps(report, indent=2) + "\n",
                encoding="utf-8",
                newline="\n",
            )
    except (OSError, PackageCheckError, json.JSONDecodeError):
        print("package-check: blocked", file=sys.stderr)
        return 1
    print("package-check: passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
