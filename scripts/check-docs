#!/usr/bin/env python3
from __future__ import annotations

import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
REQUIRED = {
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "GOVERNANCE.md",
    "AGENTS.md",
    "ORIGIN.md",
    "docs/contracts/pack-manifest-v1.md",
    "docs/contracts/compatibility-v1.md",
    "docs/security/pack-signing-v1.md",
    "docs/conformance/v1.md",
}
LINK = re.compile(r"!?\[[^\]]*\]\(([^)\s]+)(?:\s+['\"][^'\"]*['\"])?\)")


def _documents() -> tuple[Path, ...]:
    root_documents = tuple(ROOT / path for path in REQUIRED if "/" not in path)
    nested_documents = tuple(sorted((ROOT / "docs").rglob("*.md")))
    return tuple(sorted({*root_documents, *nested_documents}))


def _check_target(document: Path, raw_target: str) -> str | None:
    target = raw_target.strip("<>")
    if target.startswith(("https://", "http://", "mailto:")) or target.startswith("#"):
        return None
    path_text = target.split("#", maxsplit=1)[0]
    if not path_text:
        return None
    candidate = (document.parent / path_text).resolve()
    try:
        candidate.relative_to(ROOT)
    except ValueError:
        return "link escapes the repository"
    if not candidate.exists():
        return "link target does not exist"
    return None


def main() -> int:
    missing = sorted(path for path in REQUIRED if not (ROOT / path).is_file())
    if missing:
        print(f"docs-check: missing-required count={len(missing)}", file=sys.stderr)
        return 1
    findings: list[tuple[str, str]] = []
    for document in _documents():
        relative = document.relative_to(ROOT).as_posix()
        text = document.read_text(encoding="utf-8")
        if not text.startswith("#"):
            findings.append((relative, "missing title"))
        for match in LINK.finditer(text):
            error = _check_target(document, match.group(1))
            if error is not None:
                findings.append((relative, error))
    if findings:
        for path, error in sorted(set(findings)):
            print(f"docs-check: blocked path={path} reason={error}", file=sys.stderr)
        return 1
    print("docs-check: passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
